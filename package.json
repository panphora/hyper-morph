{
  "name": "hyper-morph",
  "description": "content-based DOM morphing library",
  "keywords": [
    "HTML",
    "DOM",
    "morph",
    "diff"
  ],
  "version": "0.5.4",
  "homepage": "https://github.com/panphora/hyper-morph",
  "bugs": {
    "url": "https://github.com/panphora/hyper-morph/issues"
  },
  "license": "MIT-0",
  "files": [
    "packed-contract.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "src",
    "dist/*.js"
  ],
  "main": "src/hyper-morph.js",
  "module": "src/hyper-morph.js",
  "type": "module",
  "exports": {
    ".": "./src/hyper-morph.js",
    "./matcher": "./src/hyper-morph-matcher.js",
    "./json-merge": "./src/hyper-morph-json-merge.js",
    "./json-parse": "./src/hyper-morph-json-parse.js"
  },
  "scripts": {
    "build": "npx esbuild src/hyper-morph.js --bundle --minify --format=iife --global-name=HyperMorph --outfile=dist/hyper-morph.min.js",
    "copy-to-hyperclayjs": "npm run build && node scripts/propagate.js --only hyperclayjs",
    "copy-to-clayjs": "npm run build && node scripts/propagate.js --only clayjs",
    "dev": "http-server . -p 5692 -o demo/index.html",
    "test": "web-test-runner",
    "test:debug": "web-test-runner --manual --open",
    "test:chrome": "web-test-runner --playwright --browsers chromium",
    "test:firefox": "web-test-runner --concurrency 1 --playwright --browsers firefox",
    "test:webkit": "web-test-runner --playwright --browsers webkit",
    "test:all": "web-test-runner --concurrency 1 --playwright --browsers chromium firefox webkit",
    "test:ci": "npm run typecheck && npm run format:check && npm run test:all -- --fail-only && node test/lib/ensure-full-coverage.js",
    "test:coverage": "npm run test:chrome && node test/lib/ensure-full-coverage.js",
    "perf": "node perf/runner.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/hyper-morph.git"
  },
  "devDependencies": {
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "chai": "^4.3.6",
    "chai-dom": "^1.11.0",
    "chromedriver": "latest",
    "esbuild": "^0.28.0",
    "fs-extra": "^9.1.0",
    "htmx.org": "1.9.9",
    "http-server": "^14.1.1",
    "lcov-parse": "^1.0.0",
    "mocha": "^11.0.1",
    "playwright": "1.56.1",
    "prettier": "^3.4.2",
    "sinon": "^9.2.4",
    "tachometer": "^0.7.1",
    "typescript": "^5.3.3",
    "uglify-js": "^3.15.0"
  },
  "hyper": {
    "kind": "lib",
    "status": "active"
  }
}
