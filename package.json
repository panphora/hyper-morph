{
  "name": "hyper-match",
  "description": "content-based DOM morphing library",
  "keywords": [
    "HTML",
    "DOM",
    "morph",
    "diff"
  ],
  "version": "0.1.0",
  "homepage": "https://github.com/panphora/hyper-match",
  "bugs": {
    "url": "https://github.com/panphora/hyper-match/issues"
  },
  "license": "0BSD",
  "files": [
    "LICENSE",
    "README.md",
    "dist/*.js"
  ],
  "main": "dist/hyper-match.js",
  "module": "dist/hyper-match.esm.js",
  "unpkg": "dist/hyper-match.min.js",
  "exports": {
    ".": {
      "require": "./dist/hyper-match.cjs.js",
      "import": "./dist/hyper-match.esm.js"
    },
    "./htmx": "./dist/hyper-match-ext.esm.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "http-server . -p 5692 -o demo/index.html",
    "test": "web-test-runner",
    "test:debug": "web-test-runner --manual --open",
    "test:chrome": "web-test-runner --playwright --browsers chromium",
    "test:firefox": "web-test-runner --concurrency 1 --playwright --browsers firefox",
    "test:webkit": "web-test-runner --playwright --browsers webkit",
    "test:all": "web-test-runner --concurrency 1 --playwright --browsers chromium firefox webkit",
    "test:ci": "npm run typecheck && npm run format:check && npm run test:all -- --fail-only && node test/lib/ensure-full-coverage.js",
    "test:coverage": "npm run test:chrome && node test/lib/ensure-full-coverage.js",
    "perf": "node perf/runner.js",
    "amd": "(echo \"define(() => {\\n\" && cat src/idiomorph.js && echo \"\\nreturn Idiomorph});\") > dist/hyper-match.amd.js",
    "cjs": "(cat src/idiomorph.js && echo \"\\nmodule.exports = Idiomorph;\") > dist/hyper-match.cjs.js",
    "esm": "(cat src/idiomorph.js && echo \"\\nexport {Idiomorph};\") > dist/hyper-match.esm.js && (echo \"import htmx from \\\"htmx.org\\\";\\n\" && cat dist/hyper-match-ext.js && echo \"\\nexport {Idiomorph};\") > dist/hyper-match-ext.esm.js",
    "gen-modules": "npm run-script amd && npm run-script cjs && npm run-script esm",
    "dist": "cp -r src/* dist/ && mv dist/idiomorph.js dist/hyper-match.js && mv dist/idiomorph-htmx.js dist/hyper-match-htmx.js && cat dist/hyper-match.js dist/hyper-match-htmx.js > dist/hyper-match-ext.js && npm run-script gen-modules && npm run-script uglify && gzip -9 -k -f dist/hyper-match.min.js > dist/hyper-match.min.js.gz && exit",
    "uglify": "uglifyjs -m eval -o dist/hyper-match.min.js dist/hyper-match.js && uglifyjs -m eval -o dist/hyper-match-ext.min.js dist/hyper-match-ext.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/hyper-match.git"
  },
  "devDependencies": {
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "chai": "^4.3.6",
    "chai-dom": "^1.11.0",
    "chromedriver": "latest",
    "fs-extra": "^9.1.0",
    "htmx.org": "1.9.9",
    "http-server": "^14.1.1",
    "lcov-parse": "^1.0.0",
    "mocha": "^11.0.1",
    "prettier": "^3.4.2",
    "sinon": "^9.2.4",
    "tachometer": "^0.7.1",
    "typescript": "^5.3.3",
    "uglify-js": "^3.15.0"
  }
}
